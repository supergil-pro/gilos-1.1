# העתיקו לקובץ .env.local (לפיתוח מקומי) והכניסו את הערכים גם ב-Vercel:
# Settings > Environment Variables. הערכים נמצאים ב-Supabase: Settings > API Keys.

# ציבוריים: בטוחים לדפדפן
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# סודי: לשרת בלבד (מחיקת חשבון). רק ב-Vercel, לעולם לא בקוד, בגיטהאב או בצ'אט.
SUPABASE_SECRET_KEY=sb_secret_...

# Freesound (חיפוש צלילים ולופים): מפתח חינמי מ-https://freesound.org/apiv2/apply — סודי, רק ב-Vercel
FREESOUND_API_KEY=

# Soundza (צלילים ומוזיקה, ויצירת צלילים מטקסט): מפתח חינמי מ-https://soundza.com/developers/keys
# מתחיל ב-sz_live_ — סודי, רק ב-Vercel. בלי מפתח: חיפוש בלבד, בלי האזנה ובלי קבצים
SOUNDZA_API_KEY=
