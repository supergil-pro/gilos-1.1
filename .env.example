# העתיקו לקובץ .env.local (לפיתוח מקומי) והכניסו את הערכים גם ב-Vercel:
# Settings > Environment Variables. הערכים נמצאים ב-Supabase: Settings > API Keys.

# ציבוריים: בטוחים לדפדפן
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# סודי: לשרת בלבד (מחיקת חשבון). רק ב-Vercel, לעולם לא בקוד, בגיטהאב או בצ'אט.
SUPABASE_SECRET_KEY=sb_secret_...
